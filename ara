@dataclass(frozen=True)
class ScopeRef:
    """A parsed --scope argument. kind is 'management-group', 'subscription' or 'guid'."""
    path: str
    kind: str
    name: str


class ScopeParser:
    """Parses the --scope argument and resolves the default depth."""
    _GUID = r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
    _PREFIXED = re.compile(
        r'^/?(?:providers/Microsoft\.Management/)?(?P<kind>managementGroups|subscriptions)/(?P<name>[^/]+)/?$',
        re.IGNORECASE)
    _BARE = re.compile(r'^(?P<name>[^/]+)$')
    _GUID_RE = re.compile('^' + _GUID + '$', re.IGNORECASE)
    VALID_FORMS = (
        "my-mg", "managementGroups/my-mg", "/providers/Microsoft.Management/managementGroups/my-mg",
        "<subscription-guid>", "subscriptions/<subscription-guid>", "/subscriptions/<subscription-guid>")

    @staticmethod
    def parse(text: str) -> ScopeRef:
        error = ValidationError(f"Invalid scope '{text}'. Valid forms: " + ", ".join(ScopeParser.VALID_FORMS))
        m = ScopeParser._PREFIXED.match(text.strip())
        if m:
            name = m.group('name')
            if m.group('kind').lower() == 'subscriptions':
                if not ScopeParser._GUID_RE.match(name):
                    raise error
                name = name.lower()
                return ScopeRef(f"/subscriptions/{name}", 'subscription', name)
            return ScopeRef(f"/providers/Microsoft.Management/managementGroups/{name}", 'management-group', name)
        m = ScopeParser._BARE.match(text.strip())
        if not m:
            raise error
        name = m.group('name')
        if ScopeParser._GUID_RE.match(name):
            return ScopeRef(f"/subscriptions/{name.lower()}", 'guid', name.lower())
        return ScopeRef(f"/providers/Microsoft.Management/managementGroups/{name}", 'management-group', name)

    @staticmethod
    def resolve_depth(kind: str, depth: Optional[str]) -> str:
        if kind == 'subscription':
            if depth is None:
                return ARAConfig.DEPTH_RESOURCE_GROUPS
            if depth == ARAConfig.DEPTH_MANAGEMENT_GROUPS:
                raise ValidationError(f"Depth '{depth}' is not valid for a subscription scope")
            return depth
        return depth or ARAConfig.DEPTH_MANAGEMENT_GROUPS


@dataclass
class Scope:
    """Represents an Azure scope (Management Group, Subscription, Resource Group, or Resource)."""
    scope_path: str
    name: str
    scope_type: str  # 'Management Group', 'Subscription', 'Resource Group', or 'Resource'
    resource_type: Optional[str] = None  # For individual resources (e.g., 'Microsoft.Compute/virtualMachines')
    subscription_id: Optional[str] = None
    
    def __post_init__(self):
        """Validate scope data."""
        if not self.scope_path:
            raise ValidationError("Scope path cannot be empty")
        if not self.name:
            raise ValidationError("Scope name cannot be empty")
        valid_types = ['Management Group', 'Subscription', 'Resource Group', 'Resource']
        if self.scope_type not in valid_types:
            raise ValidationError(f"Invalid scope type: {self.scope_type}. Must be one of {valid_types}")
    
    _MG_PATH = re.compile(r'^/providers/Microsoft\.Management/managementGroups/([^/]+)/?$', re.IGNORECASE)
    _SUB_PATH = re.compile(r'^/subscriptions/([^/]+)(?:/(.*))?$', re.IGNORECASE)

    @staticmethod
    def from_path(path: str) -> 'Scope':
        """Classify an ARM scope path. Raises ValidationError if it cannot."""
        p = path.rstrip('/')
        m = Scope._MG_PATH.match(p)
        if m:
            return Scope(p, m.group(1), 'Management Group')
        m = Scope._SUB_PATH.match(p)
        if not m:
            raise ValidationError(f"Cannot classify scope path: '{path}'")
        sub, rest = m.group(1), (m.group(2) or '')
        if not rest:
            return Scope(p, sub, 'Subscription', subscription_id=sub)
        parts = rest.split('/')
        if parts[0].lower() == 'resourcegroups':
            if len(parts) == 2 and parts[1]:
                return Scope(p, parts[1], 'Resource Group', subscription_id=sub)
            parts = parts[2:]
        if len(parts) >= 4 and parts[0].lower() == 'providers' and len(parts) % 2 == 0:
            # providers/<namespace>/<type>/<name>[/<subtype>/<name>...]
            rtype = '/'.join([parts[1]] + parts[2::2])
            return Scope(p, parts[-1], 'Resource', resource_type=rtype, subscription_id=sub)
        raise ValidationError(f"Cannot classify scope path: '{path}'")


@dataclass
class ScanResult:
    """Outcome of one scan: the assignments plus what was and was not covered."""
    scope: str
    scope_name: str
    depth: str
    scan_timestamp: str  # UTC, YYYY-MM-DDTHH:MM:SSZ
    assignments: List[RoleAssignment]
    failed_scopes: List[Dict[str, str]] = field(default_factory=list)  # {"scope", "error"}
    pim_skipped: bool = False
    pim_unavailable_scopes: List[str] = field(default_factory=list)
    names: str = "unavailable"
    management_groups_scanned: int = 0
    subscriptions_scanned: int = 0
    filters_applied: Dict[str, Any] = field(default_factory=dict)
    assignments_before_filters: int = 0
    stopped: bool = False
    interrupted: bool = False
    filters_not_applied: bool = False

    @property
    def complete(self) -> bool:
        return not (self.failed_scopes or self.stopped or self.interrupted or self.filters_not_applied)

    @property
    def pim_status(self) -> str:
        if self.pim_skipped:
            return "skipped"
        if not self.pim_unavailable_scopes:
            return "included"
        if len(self.pim_unavailable_scopes) >= self.management_groups_scanned + self.subscriptions_scanned:
            return "unavailable"
        return "partial"

    @property
    def scopes_with_assignments(self) -> int:
        return len({a.scope.lower() for a in self.assignments})

    def to_dict(self) -> Dict:
        return {
            "metadata": {
                "tool": "ARA",
                "version": __version__,
                "schema_version": 3,
                "scan_timestamp": self.scan_timestamp,
                "scope": self.scope,
                "depth": self.depth,
                "complete": self.complete,
                "failed_scopes": self.failed_scopes,
                "pim": self.pim_status,
                "pim_unavailable_scopes": self.pim_unavailable_scopes,
                "names": self.names,
                "filters_applied": self.filters_applied,
                "management_groups_scanned": self.management_groups_scanned,
                "subscriptions_scanned": self.subscriptions_scanned,
                "scopes_with_assignments": self.scopes_with_assignments,
                "total_assignments_found": len(self.assignments),
                "assignments_before_filters": self.assignments_before_filters,
            },
            "role_assignments": [asdict(a) for a in self.assignments],
        }


# Authentication System
class AuthenticationProvider(ABC):
    """Abstract base class for authentication providers."""
    
    @abstractmethod
    def get_token(self) -> Optional[str]:
        """Get authentication token."""
        pass
    
    @abstractmethod
    def get_name(self) -> str:
        """Get provider name for logging."""
        pass


class EnvironmentAuthProvider(AuthenticationProvider):
    """Get token from environment variables."""
    
    def get_token(self) -> Optional[str]:
        """Get token from environment variables."""
        for var_name in ARAConfig.TOKEN_ENV_VARS:
            token = os.getenv(var_name)
            if token and token.strip():
                logger.debug(f"Found token in environment variable: {var_name}")
                return token.strip()
        return None
    
    def get_name(self) -> str:
        """Get provider name."""
        return "environment variables"


class AzureCliAuthProvider(AuthenticationProvider):
    """Get token from Azure CLI."""
    
    def get_token(self, resource: str = ARAConfig.AZURE_MANAGEMENT_URL) -> Optional[str]:
        """Get a token for `resource` from Azure CLI; None when az is not installed or not logged in."""
        az = shutil.which('az')
        if not az:
            return None
        try:
            result = subprocess.run(
                [az, 'account', 'get-access-token', '--resource', resource],
                capture_output=True,
                text=True,
                check=True,
                timeout=ARAConfig.TOKEN_VALIDATION_TIMEOUT
            )
            
            token_data = json.loads(result.stdout)
            token = token_data.get('accessToken')
            if token:
                logger.debug("Retrieved token from Azure CLI")
                return token
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError, json.JSONDecodeError):
            logger.debug("Could not retrieve token from Azure CLI")
        return None
    
    def get_name(self) -> str:
        """Get provider name."""
        return "Azure CLI"


class InteractiveAuthProvider(AuthenticationProvider):
    """Get token through interactive prompt."""
    
    def get_token(self) -> Optional[str]:
        """Prompt for a token; only when stdin is a terminal."""
        if not sys.stdin.isatty():
            return None
        print("Azure authentication required. Provide an access token that can read")
        print("role assignments and management groups. To get one, run:")
        print("  az account get-access-token --resource https://management.azure.com")
        print()
        
        try:
            import getpass
            token = getpass.getpass("Azure access token: ").strip()
            if not token:
                logger.warning("No token provided")
                return None
            return token
        except KeyboardInterrupt:
            print("\nAuthentication cancelled.")
            return None
        except Exception as e:
            logger.error(f"Error during interactive authentication: {e}")
            return None
    
    def get_name(self) -> str:
        """Get provider name."""
        return "interactive prompt"


class AzureAuthenticationManager:
    """Finds a token: --token, environment variables, Azure CLI, then an interactive prompt."""
    
    def __init__(self):
        self.providers = [EnvironmentAuthProvider(), AzureCliAuthProvider(), InteractiveAuthProvider()]
        self.source = None  # type: Optional[AuthenticationProvider]
    
    def get_token(self, override_token: Optional[str] = None) -> str:
        """Get Azure access token using various methods."""
        if override_token:
            logger.info("Using provided token")
            return override_token
        
        logger.info("Looking for Azure authentication...")
        
        for provider in self.providers:
            token = provider.get_token()
            if token:
                logger.info(f"Authenticated via {provider.get_name()}")
                self.source = provider
                return token
        
        raise AuthenticationError("No Azure token found. Pass --token, set AZURE_ACCESS_TOKEN, or run az login.")
    
    def refresher(self) -> Optional[Callable[[], Optional[str]]]:
        """The Azure CLI token getter when the token came from az, otherwise None."""
        return self.source.get_token if isinstance(self.source, AzureCliAuthProvider) else None


# API Clients
class HttpClient:
    """JSON over HTTPS with a bearer token, retries, pagination and one token refresh on 401."""

    def __init__(self, token: str, api_delay: float = ARAConfig.DEFAULT_API_DELAY,
                 refresh_token: Optional[Callable[[], Optional[str]]] = None,
                 opener: Callable = urllib.request.urlopen, sleep: Callable[[float], None] = time.sleep):
        if not token:
            raise ValueError("Token cannot be empty")
        self.token = token
        self.api_delay = api_delay
        self.refresh_token = refresh_token
        self.opener = opener
        self.sleep = sleep
        self._last_request_time = 0.0

    def _apply_rate_limit(self) -> None:
        """Apply rate limiting between API calls."""
        if self.api_delay > 0:
            time_since_last = time.time() - self._last_request_time
            if time_since_last < self.api_delay:
                self.sleep(self.api_delay - time_since_last)
            self._last_request_time = time.time()

    def request(self, method: str, url: str, params: Optional[Dict] = None, body: Optional[Dict] = None) -> Dict:
        """Send one request; retry 429, 5xx and network errors; refresh the token once on 401."""
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        refreshed = False
        for attempt in range(ARAConfig.MAX_ATTEMPTS):
            self._apply_rate_limit()
            request = urllib.request.Request(url, data=data, method=method, headers={
                'Authorization': f'Bearer {self.token}',
                'Content-Type': 'application/json',
                'User-Agent': 'ARA/3.0.0',
            })
            retry_after = None
            try:
                with self.opener(request, timeout=ARAConfig.API_REQUEST_TIMEOUT) as response:
                    return json.loads(response.read().decode() or "{}")
            except urllib.error.HTTPError as e:
                if e.code == ARAConfig.HTTP_UNAUTHORIZED:
                    new_token = self.refresh_token() if self.refresh_token and not refreshed else None
                    if not new_token:
                        raise AuthenticationError(f"Token rejected (HTTP 401) for {url}")
                    self.token, refreshed = new_token, True
                    continue
                try:
                    detail = e.read().decode(errors="replace")
                except Exception:
                    detail = ""
                error = APIError(f"HTTP {e.code} for {url}: {detail}", e.code)
                if e.code != ARAConfig.HTTP_RATE_LIMITED and e.code < ARAConfig.HTTP_SERVER_ERROR:
                    raise error
                retry_after = (e.headers or {}).get("Retry-After")
            except json.JSONDecodeError as e:
                raise APIError(f"Invalid JSON response from {url}: {e}")
            except OSError as e:  # URLError, socket.timeout, connection resets
                error = APIError(f"Network error for {url}: {e}")
            if attempt == ARAConfig.MAX_ATTEMPTS - 1:
                raise error
            wait = int(retry_after) if retry_after and retry_after.strip().isdigit() else ARAConfig.RETRY_WAITS[attempt]
            logger.warning(f"{error}. Retrying in {wait}s (attempt {attempt + 1}/{ARAConfig.MAX_ATTEMPTS})")
            self.sleep(wait)
        raise APIError(f"No response after {ARAConfig.MAX_ATTEMPTS} attempts for {url}")  # 401 refresh used the last attempt

    def get(self, url: str, params: Optional[Dict] = None) -> Dict:
        return self.request("GET", url, params)

    def get_all(self, url: str, params: Optional[Dict] = None) -> List[Dict]:
        """Concatenate `value` over all pages, following `nextLink` as given."""
        items = []  # type: List[Dict]
        while url:
            page = self.get(url, params)
            items.extend(page.get("value", []))
            url, params = page.get("nextLink"), None
        return items


class AzureAPIClient(HttpClient):
    """HttpClient for Azure Resource Manager."""
    BASE = ARAConfig.AZURE_MANAGEMENT_URL

    def url(self, path: str) -> str:
        return self.BASE + path


class HierarchyClient:
    """Reads the management group tree and subscription details."""

    def __init__(self, api: AzureAPIClient):
        self.api = api

    def management_group_tree(self, mg_id: str) -> Tuple[List[Scope], List[Scope]]:
        """Management groups (root first) and subscriptions under mg_id, from one recursive call."""
        root = self.api.get(self.api.url(f"/providers/Microsoft.Management/managementGroups/{mg_id}"), {
            "api-version": ARAConfig.MGMT_GROUP_API_VERSION, "$expand": "children", "$recurse": "true"})
        props = root.get('properties') or {}
        mgs = [Scope(f"/providers/Microsoft.Management/managementGroups/{mg_id}",
                     props.get('displayName') or mg_id, 'Management Group')]
        subs = []  # type: List[Scope]

        def walk(children):
            for child in children or []:
                child_type, child_id = child.get('type', ''), child.get('name', '')
                name = child.get('displayName') or child_id
                if child_type.endswith('/managementGroups'):
                    mgs.append(Scope(f"/providers/Microsoft.Management/managementGroups/{child_id}",
                                     name, 'Management Group'))
                    walk(child.get('children'))
                elif child_type == '/subscriptions':
                    subs.append(Scope(f"/subscriptions/{child_id}", name, 'Subscription',
                                      subscription_id=child_id))

        walk(props.get('children'))
        return mgs, subs

    def subscription(self, subscription_id: str) -> Scope:
        """The subscription with its display name. APIError passes through."""
        data = self.api.get(self.api.url(f"/subscriptions/{subscription_id}"),
                            {"api-version": ARAConfig.AZURE_API_VERSION})
        return Scope(f"/subscriptions/{subscription_id}", data.get('displayName') or subscription_id,
                     'Subscription', subscription_id=subscription_id)


class AssignmentCollector:
    """Lists role assignments once per management group or subscription, and role names per scope."""

    def __init__(self, api: AzureAPIClient):
        self.api = api

    def _list(self, scope_path: str, kind: str, params: Dict) -> List[Dict]:
        params = dict(params, **{"api-version": ARAConfig.AUTH_API_VERSION})
        return self.api.get_all(self.api.url(f"{scope_path}/providers/Microsoft.Authorization/{kind}"), params)

    @staticmethod
    def inside(scope_path: str, container_path: str) -> bool:
        """True when scope_path is container_path or below it, ignoring case."""
        scope, container = scope_path.lower(), container_path.lower().rstrip('/')
        return scope == container or scope.startswith(container + '/')

    def for_management_group(self, mg: Scope) -> List[Dict]:
        rows = self._list(mg.scope_path, "roleAssignments", {"$filter": "atScope()"})
        return [r for r in rows if r.get('properties', {}).get('scope', '').lower() == mg.scope_path.lower()]

    def for_subscription(self, sub: Scope) -> List[Dict]:
        rows = self._list(sub.scope_path, "roleAssignments", {})
        return [r for r in rows if self.inside(r.get('properties', {}).get('scope', ''), sub.scope_path)]

    def role_names(self, scope_path: str) -> Dict[str, str]:
        """Role definition GUID (lowercase) to role name."""
        return {d['id'].rsplit('/', 1)[-1].lower(): d['properties']['roleName']
                for d in self._list(scope_path, "roleDefinitions", {})}


class DepthFilter:
    """Decides whether a scope falls within the scan depth and resource type filter."""
    _LEVEL = {'Management Group': 0, 'Subscription': 1, 'Resource Group': 2, 'Resource': 3}
    _MAX_LEVEL = {ARAConfig.DEPTH_MANAGEMENT_GROUPS: 0, ARAConfig.DEPTH_SUBSCRIPTIONS: 1,
                  ARAConfig.DEPTH_RESOURCE_GROUPS: 2, ARAConfig.DEPTH_RESOURCES: 3}

    @staticmethod
    def keep(scope: Scope, depth: str, resource_types: Optional[List[str]]) -> bool:
        if DepthFilter._LEVEL[scope.scope_type] > DepthFilter._MAX_LEVEL[depth]:
            return False
        if scope.scope_type == 'Resource' and resource_types:
            return scope.resource_type.lower() in [t.lower() for t in resource_types]
        return True


class PIMCollector:
    """Lists PIM eligible and active schedule instances once per management group or subscription."""

    def __init__(self, api: AzureAPIClient):
        self.api = api

    def _list(self, scope: Scope, kind: str) -> List[Dict]:
        mg = scope.scope_type == 'Management Group'
        params = {"api-version": ARAConfig.PIM_API_VERSION}
        if mg:
            params["$filter"] = "atScope()"
        try:
            rows = self.api.get_all(self.api.url(f"{scope.scope_path}/providers/Microsoft.Authorization/{kind}"), params)
        except APIError as e:
            if e.status == 403:
                raise PIMUnavailable(str(e)) from e
            raise
        at = lambda r: r.get('properties', {}).get('scope', '')
        if mg:
            return [r for r in rows if at(r).lower() == scope.scope_path.lower()]
        return [r for r in rows if AssignmentCollector.inside(at(r), scope.scope_path)]

    def eligible(self, scope: Scope) -> List[Dict]:
        return self._list(scope, "roleEligibilityScheduleInstances")

    def active(self, scope: Scope) -> List[Dict]:
        return self._list(scope, "roleAssignmentScheduleInstances")


class AssignmentBuilder:
    """Turns RBAC rows and PIM schedule instances into RoleAssignments."""

    def __init__(self, role_names: Dict[str, str], subscription_names: Dict[str, str]):
        self.role_names = role_names  # lowercased role definition GUID to name
        self.subscription_names = subscription_names  # lowercased subscription GUID to display name

    def build(self, rbac_rows: List[Dict], active_instances: Optional[List[Dict]],
              eligible_instances: Optional[List[Dict]]) -> List[RoleAssignment]:
        """None for the instance lists means PIM was skipped or unavailable."""
        by_origin = {}  # type: Dict[str, Dict]
        for i in active_instances or []:
            origin = i.get('properties', {}).get('originRoleAssignmentId')
            if origin:
                by_origin[origin.lower()] = i['properties']
        out = []  # type: List[RoleAssignment]
        for r in rbac_rows:
            inst = by_origin.get(r.get('id', '').lower(), {})
            kind = ('Active time-bound' if inst.get('endDateTime') else 'Active permanent') if inst else 'Active'
            self._add(out, r, r.get('properties', {}), inst, kind)
        for e in eligible_instances or []:
            p = e.get('properties', {})
            self._add(out, e, p, p, 'Eligible time-bound' if p.get('endDateTime') else 'Eligible permanent')
        return out

    def _add(self, out: List[RoleAssignment], item: Dict, props: Dict, inst: Dict, kind: str) -> None:
        """item is the source row; props gives principal, role and scope; inst (a schedule instance, or {}) gives names and dates."""
        expanded = inst.get('expandedProperties') or {}
        role_id = props.get('roleDefinitionId', '')
        guid = role_id.rsplit('/', 1)[-1]
        try:
            scope = Scope.from_path(props.get('scope', ''))
            name = scope.name
            if scope.scope_type == 'Subscription':
                name = self.subscription_names.get(scope.subscription_id.lower()) or name
            out.append(RoleAssignment(
                principal_id=props.get('principalId', ''),
                principal_name=(expanded.get('principal') or {}).get('displayName') or None,
                principal_type=props.get('principalType', 'Unknown'),
                role_name=self.role_names.get(guid.lower()) or (expanded.get('roleDefinition') or {}).get('displayName') or guid,
                role_id=role_id, scope=scope.scope_path, scope_name=name, scope_type=scope.scope_type,
                resource_type=scope.resource_type, assignment_type=kind,
                start_date_time=inst.get('startDateTime'), end_date_time=inst.get('endDateTime')))
        except ValidationError as e:
            logger.warning(f"Skipping assignment {item.get('id') or props.get('scope')}: {e}")


class Scanner:
    """Walks the management groups and subscriptions under a scope and collects their assignments."""

    def __init__(self, hierarchy: HierarchyClient, collector: AssignmentCollector,
                 pim: Optional[PIMCollector], show_progress: bool = True):
        self.hierarchy = hierarchy
        self.collector = collector
        self.pim = pim  # None means --skip-pim
        self.show_progress = show_progress

    def resolve(self, ref: ScopeRef) -> ScopeRef:
        """A bare GUID is a subscription, or a management group when no such subscription exists."""
        if ref.kind != 'guid':
            return ref
        try:
            self.hierarchy.subscription(ref.name)
            return ScopeRef(ref.path, 'subscription', ref.name)
        except APIError as e:
            if e.status != 404:
                raise
            return ScopeRef(f"/providers/Microsoft.Management/managementGroups/{ref.name}", 'management-group', ref.name)

    def scan(self, ref: ScopeRef, depth: str, resource_types: Optional[List[str]] = None) -> ScanResult:
        """Errors reading the root scope are raised; after that, a ScanResult is always returned."""
        timestamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        if ref.kind == 'management-group':
            mgs, subs = self.hierarchy.management_group_tree(ref.name)
        else:
            mgs, subs = [], [self.hierarchy.subscription(ref.name)]
        result = ScanResult(ref.path, ref.name, depth, timestamp, [], pim_skipped=self.pim is None)
        sub_names = {s.subscription_id.lower(): s.name for s in subs}
        scopes = mgs + ([] if depth == ARAConfig.DEPTH_MANAGEMENT_GROUPS else subs)
        try:
            with ProgressTracker(total=len(scopes), desc="Scanning scopes", disable=not self.show_progress) as progress:
                for scope in scopes:
                    try:
                        self._scan_one(scope, depth, resource_types, sub_names, result)
                    except APIError as e:
                        result.failed_scopes.append({"scope": scope.scope_path, "error": str(e)})
                    progress.update(1)
        except AuthenticationError as e:
            logger.error(f"Scan stopped: {e}")
            result.stopped = True
        except KeyboardInterrupt:
            result.interrupted = True
        result.assignments_before_filters = len(result.assignments)
        return result

    def _scan_one(self, scope: Scope, depth: str, resource_types: Optional[List[str]],
                  sub_names: Dict[str, str], result: ScanResult) -> None:
        is_mg = scope.scope_type == 'Management Group'
        role_names = self.collector.role_names(scope.scope_path)
        rows = self.collector.for_management_group(scope) if is_mg else self.collector.for_subscription(scope)
        active = eligible = None  # type: Optional[List[Dict]]
        if self.pim:
            try:
                eligible, active = self.pim.eligible(scope), self.pim.active(scope)
            except PIMUnavailable:
                if not result.pim_unavailable_scopes:
                    logger.warning("PIM data is not readable with this account; affected assignments get the type 'Active'.")
                result.pim_unavailable_scopes.append(scope.scope_path)
        built = AssignmentBuilder(role_names, sub_names).build(rows, active, eligible)
        result.assignments.extend(a for a in built if DepthFilter.keep(Scope.from_path(a.scope), depth, resource_types))
        if is_mg:
            result.management_groups_scanned += 1
        else:
            result.subscriptions_scanned += 1


class GraphAPIClient(HttpClient):
    """HttpClient for Microsoft Graph."""
    IDS_PER_CALL = 1000  # getByIds limit

    @classmethod
    def create(cls, az_token: Callable[[], Optional[str]]) -> Optional['GraphAPIClient']:
        """Token from AZURE_GRAPH_TOKEN, else from az_token(); None when neither gives one."""
        token = os.environ.get('AZURE_GRAPH_TOKEN') or az_token()
        return cls(token) if token else None

    def get_by_ids(self, ids: List[str]) -> Dict[str, Dict]:
        """Look up users, groups and service principals; maps lowercased id to the returned object."""
        found = {}  # type: Dict[str, Dict]
        for i in range(0, len(ids), self.IDS_PER_CALL):
            page = self.request("POST", f"{ARAConfig.GRAPH_API_URL}/directoryObjects/getByIds",
                                body={"ids": ids[i:i + self.IDS_PER_CALL], "types": ["user", "group", "servicePrincipal"]})
            found.update((obj["id"].lower(), obj) for obj in page.get("value", []) if obj.get("id"))
        return found


class PrincipalResolver:
    """Fills principal names: PIM names first, then Microsoft Graph in batches."""

    def __init__(self, graph: Optional[GraphAPIClient]):
        self.graph = graph

    def resolve(self, assignments: List[RoleAssignment]) -> Tuple[List[RoleAssignment], str]:
        """Return the assignments with names filled in, and the names status."""
        if self.graph is None:
            logger.warning("No Microsoft Graph token. Principal names come from PIM only.")
        else:
            try:
                found = self.graph.get_by_ids(sorted({a.principal_id.lower() for a in assignments}))
            except ARAError as e:
                logger.warning(f"Microsoft Graph lookup failed: {e}. Principal names come from PIM only.")
            else:
                return [self._apply(a, found.get(a.principal_id.lower())) for a in assignments], "resolved"
        named = sum(1 for a in assignments if a.principal_name)
        return assignments, "resolved" if named == len(assignments) else "unavailable" if named == 0 else "partial"

    @staticmethod
    def _apply(assignment: RoleAssignment, obj: Optional[Dict]) -> RoleAssignment:
        if obj is None:
            return assignment if assignment.principal_name else replace(assignment, principal_name="Unknown")
        principal_type = 'ManagedIdentity' if obj.get('servicePrincipalType') == 'ManagedIdentity' else assignment.principal_type
        return replace(assignment, principal_name=obj.get('displayName') or assignment.principal_name,
                       principal_type=principal_type)


# Output Handlers
class OutputHandler(ABC):
    """Renders a ScanResult to text and writes it atomically into the output directory."""
    extension: str

    def __init__(self, output_dir: str):
        self.output_dir = output_dir

    @abstractmethod
    def render(self, results: ScanResult) -> str:
        pass

    def file_name(self, results: ScanResult) -> str:
        safe = re.sub(r'[^A-Za-z0-9_-]', '_', results.scope_name)
        partial = "" if results.complete else ".partial"
        return f"role_assignments_{safe}{partial}.{self.extension}"

    def generate(self, results: ScanResult) -> str:
        path = os.path.join(self.output_dir, self.file_name(results))
        text = self.render(results)
        try:
            os.makedirs(self.output_dir, exist_ok=True)
            with open(path + ".tmp", 'w', encoding='utf-8', newline='') as f:
                f.write(text)
            os.replace(path + ".tmp", path)
        except OSError as e:
            try:
                os.remove(path + ".tmp")
            except OSError:
                pass
            raise ExportError(f"Failed to write {path}: {e}")
        return path


class JSONOutputHandler(OutputHandler):
    extension = "json"

    def render(self, results: ScanResult) -> str:
        return json.dumps(results.to_dict(), indent=ARAConfig.JSON_INDENT, ensure_ascii=False)


class CSVOutputHandler(OutputHandler):
    extension = "csv"
    COLUMNS = ("Name", "Principal ID", "Type", "Role", "Scope", "Scope Path", "Scope Type",
               "Assignment Type", "Resource Type", "Start Date", "End Date")

    @staticmethod
    def escape(value: Optional[str]) -> str:
        """Neutralise spreadsheet formula injection."""
        if value is None:
            return ""
        return "'" + value if value[:1] in ("=", "+", "-", "@") else value

    def render(self, results: ScanResult) -> str:
        buf = io.StringIO()
        writer = csv.writer(buf, lineterminator="\n")
        writer.writerow(self.COLUMNS)
        for a in results.assignments:
            writer.writerow([self.escape(v) for v in (
                a.principal_name, a.principal_id, a.principal_type, a.role_name, a.scope_name, a.scope,
                a.scope_type, a.assignment_type, a.resource_type, a.start_date_time, a.end_date_time)])
        return buf.getvalue()


class ConsoleSummary:
    """Prints the scan outcome: counts, roles, gaps and written files."""

    def print(self, results: ScanResult, paths: List[str]) -> None:
        print(f"Found {len(results.assignments)} role assignments in "
                   f"{results.management_groups_scanned} management groups and "
                   f"{results.subscriptions_scanned} subscriptions.")
        roles = Counter(a.role_name for a in results.assignments)
        for role, count in sorted(roles.items(), key=lambda kv: (-kv[1], kv[0])):
            print(f"  {count:>6}  {role}")
        if results.pim_status != "included":
            print(f"PIM: {results.pim_status}")
        if results.names != "resolved":
            print(f"Names: {results.names}")
        for failed in results.failed_scopes:
            print(f"Failed scope: {failed['scope']}: {failed['error']}")
        for path in paths:
            print(f"Written: {path}")


# Main Application
class ARAApplication:
    """Parses the scope, scans, resolves names, filters and writes the outputs."""

    def __init__(self, scanner_factory: Optional[Callable] = None, graph_factory: Optional[Callable] = None):
        self.auth = AzureAuthenticationManager()
        self.token = None  # type: Optional[str]
        self.scanner_factory = scanner_factory or self._scanner
        self.graph_factory = graph_factory or (lambda: GraphAPIClient.create(
            lambda: AzureCliAuthProvider().get_token("https://graph.microsoft.com")))
        self.last_result = None  # type: Optional[ScanResult]

    def _scanner(self, args: argparse.Namespace) -> Scanner:
        api = AzureAPIClient(self.token, args.api_delay, refresh_token=self.auth.refresher())
        return Scanner(HierarchyClient(api), AssignmentCollector(api),
                       None if args.skip_pim else PIMCollector(api),
                       show_progress=not (args.no_progress or args.debug))

    def handlers(self, args: argparse.Namespace) -> List[OutputHandler]:
        handlers = [JSONOutputHandler(args.output_dir)]  # type: List[OutputHandler]
        if args.format == "csv":
            handlers.append(CSVOutputHandler(args.output_dir))
        return handlers

    def run(self, args: argparse.Namespace) -> int:
        """Run one scan and return the exit code."""
        try:
            ref = ScopeParser.parse(args.scope)
            assignment_filter = AssignmentFilter(args)
            if args.resource_types and args.depth != ARAConfig.DEPTH_RESOURCES:
                raise ValidationError("--resource-types needs --depth resources")
        except ValidationError as e:
            logger.error(str(e))
            return ARAConfig.EXIT_CODE_USAGE

        try:
            self.token = self.auth.get_token(args.token)
        except AuthenticationError as e:
            logger.error(str(e))
            return ARAConfig.EXIT_CODE_ERROR
        graph = self.graph_factory()
        if assignment_filter.needs_graph() and graph is None:
            logger.error("--principal-name-filter and --exclude-managed-identities need a Microsoft Graph token. "
                         "Run az login or set AZURE_GRAPH_TOKEN.")
            return ARAConfig.EXIT_CODE_ERROR

        scanner = self.scanner_factory(args)
        try:
            ref = scanner.resolve(ref)
            results = scanner.scan(ref, ScopeParser.resolve_depth(ref.kind, args.depth), args.resource_types)
        except ValidationError as e:
            logger.error(str(e))
            return ARAConfig.EXIT_CODE_USAGE
        except (APIError, AuthenticationError) as e:
            logger.error(f"Cannot read {ref.path}: {e}")
            return ARAConfig.EXIT_CODE_ERROR

        assignments, results.names = PrincipalResolver(graph).resolve(results.assignments)
        if assignment_filter.needs_graph() and results.names != "resolved":
            logger.warning("Principal names are incomplete. Filters were not applied.")
            results.assignments = assignments
            results.filters_not_applied = True
        else:
            results.assignments_before_filters = len(assignments)
            results.assignments = assignment_filter.apply(assignments)
            results.filters_applied = assignment_filter.get_summary()
        self.last_result = results

        try:
            paths = [handler.generate(results) for handler in self.handlers(args)]
        except ExportError as e:
            logger.error(str(e))
            return ARAConfig.EXIT_CODE_ERROR
        ConsoleSummary().print(results, paths)
        if results.interrupted:
            return ARAConfig.EXIT_CODE_INTERRUPT
        return ARAConfig.EXIT_CODE_SUCCESS if results.complete else ARAConfig.EXIT_CODE_INCOMPLETE


def parse_arguments(argv: Optional[List[str]] = None) -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        description=f"ARA, {ARAConfig.DESCRIPTOR}. {ARAConfig.SLOGAN}\n"
                    f"Exports the role assignments under a management group or subscription. Version {__version__}.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Authentication (tried in order):
  1. --token argument
  2. Environment variables (AZURE_ACCESS_TOKEN, AZURE_TOKEN, ARM_ACCESS_TOKEN)
  3. Azure CLI (az account get-access-token)
  4. Interactive prompt (only in a terminal)
  Principal names come from Microsoft Graph: AZURE_GRAPH_TOKEN, else Azure CLI.

Output:
  A JSON file is always written to --output-dir (default: results).
  An incomplete scan writes *.partial.* files.

Exit codes:
  0 complete, 1 error and nothing written, 2 usage error,
  3 incomplete with files written, 130 interrupted with partial files written.

Examples:
  ara --scope my-mg
  ara --scope /providers/Microsoft.Management/managementGroups/my-mg --depth subscriptions
  ara --scope xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx --depth resources
  ara --scope my-mg --format csv --role-filter "Owner,User Access Administrator"
        """
    )
    
    parser.add_argument(
        '--scope',
        required=True,
        help='Scope to scan. Management group: "my-mg" or full path. Subscription: GUID or "/subscriptions/{guid}"'
    )
    
    parser.add_argument(
        '--token',
        help='Azure access token (overrides auto-detection)'
    )
    
    parser.add_argument(
        '--depth',
        choices=[
            ARAConfig.DEPTH_MANAGEMENT_GROUPS,
            ARAConfig.DEPTH_SUBSCRIPTIONS,
            ARAConfig.DEPTH_RESOURCE_GROUPS,
            ARAConfig.DEPTH_RESOURCES
        ],
        default=None,
        help=f'Lowest scope level to include (default: {ARAConfig.DEPTH_MANAGEMENT_GROUPS} for a management group, '
             f'{ARAConfig.DEPTH_RESOURCE_GROUPS} for a subscription)'
    )
    
    parser.add_argument(
        '--resource-types',
        nargs='+',
        help='Keep only resources of these types (e.g. Microsoft.Compute/virtualMachines). '
             'Needs --depth resources'
    )
    
    parser.add_argument(
        '--api-delay',
        type=float,
        default=ARAConfig.DEFAULT_API_DELAY,
        help=f'Delay between API calls in seconds (default: {ARAConfig.DEFAULT_API_DELAY}). '
             'Increase to avoid rate limiting'
    )
    
    parser.add_argument(
        '--format',
        choices=['csv'],
        default=None,
        help='Also write a CSV file next to the JSON file'
    )
    
    parser.add_argument(
        '--output-dir',
        default=ARAConfig.RESULTS_DIR,
        help=f'Directory for the output files (default: {ARAConfig.RESULTS_DIR})'
    )
    
    parser.add_argument(
        '--skip-pim',
        action='store_true',
        help='Skip PIM (Privileged Identity Management) API calls. '
             'All assignments then get the type "Active"'
    )
    
    parser.add_argument(
        '--role-filter',
        type=str,
        help='Filter by role name (comma-separated for multiple). '
             'Example: --role-filter "Owner,Contributor"'
    )
    
    parser.add_argument(
        '--principal-type-filter',
        type=str,
        help='Filter by principal type (comma-separated for multiple). '
             f'Valid types: {", ".join(ARAConfig.PRINCIPAL_TYPES)}. '
             'Example: --principal-type-filter "User,Group"'
    )
    
    parser.add_argument(
        '--principal-name-filter',
        type=str,
        help='Filter by principal name (regex, case-insensitive). Needs a Microsoft Graph token. '
             'Example: --principal-name-filter "^Admin"'
    )
    
    parser.add_argument(
        '--assignment-type-filter',
        type=str,
        help='Filter by assignment type (comma-separated for multiple). '
             f'Valid types: {", ".join(ARAConfig.ASSIGNMENT_TYPES)}. '
             'Example: --assignment-type-filter "Active permanent,Eligible permanent"'
    )
    
    parser.add_argument(
        '--exclude-managed-identities',
        action='store_true',
        help='Leave out managed identities. Needs a Microsoft Graph token'
    )
    
    parser.add_argument(
        '--no-progress',
        action='store_true',
        help='Disable progress bar display'
    )
    
    parser.add_argument(
        '--debug',
        action='store_true',
        help='Enable debug output'
    )
    
    parser.add_argument(
        '--version',
        action='version',
        version=f'ARA {__version__}'
    )
    
    return parser.parse_args(argv)


def main() -> int:
    """Main application entry point."""
    args = parse_arguments()
    if args.debug:
        logging.getLogger().setLevel(logging.DEBUG)
    try:
        return ARAApplication().run(args)
    except KeyboardInterrupt:
        logger.info("Cancelled.")
        return ARAConfig.EXIT_CODE_INTERRUPT


if __name__ == "__main__":
    sys.exit(main())
