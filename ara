def safe_print(*args, **kwargs):
    """Print function that handles BrokenPipeError gracefully."""
    try:
        print(*args, **kwargs)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except OSError:
            pass
        sys.exit(0)


